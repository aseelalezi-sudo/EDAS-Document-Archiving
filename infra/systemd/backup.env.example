# Copy to /etc/edas/backup.env (root:edas 0640) and replace every placeholder.
BACKUP_DIR=/srv/edas-backups
RETENTION_DAYS=30
POSTGRES_DB=edas
POSTGRES_USER=edas

# Off-site copy. Leave BACKUP_OFFSITE_BUCKET empty to keep local backups only;
# the scripts then state explicitly that no off-site copy happened.
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_PREFIX=edas
BACKUP_OFFSITE_RETENTION_DAYS=30
BACKUP_S3_REGION=eu-central-1
# Optional S3-compatible endpoint (MinIO, Wasabi, Backblaze, ...)
# BACKUP_S3_ENDPOINT=https://s3.eu-central-1.example.com

# Encryption: prefer a root-owned passphrase file (or a Docker/system secret file).
# The passphrase must not live inside the backup bucket.
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/edas/backup-passphrase
# BACKUP_ENCRYPTION_PASSPHRASE=

# Credentials for the off-site account/environment (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, or AWS_PROFILE). Never commit them.
