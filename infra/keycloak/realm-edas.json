{
  "realm": "edas",
  "enabled": true,
  "displayName": "EDAS — Document Archiving",
  "displayNameHtml": "EDAS — نظام أرشفة الوثائق",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Regular employee — create and view own documents" },
      { "name": "supervisor", "description": "Section supervisor — approve section documents" },
      { "name": "dept_manager", "description": "Department manager — full departmental access" },
      { "name": "archivist", "description": "Archivist — records and retention management" },
      { "name": "auditor", "description": "Auditor — read-only access to audit trails" },
      { "name": "system_admin", "description": "System administrator — full access" }
    ]
  },
  "clients": [
    {
      "clientId": "edas-web",
      "name": "EDAS Web",
      "description": "Single-page application (OIDC public client, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:4173/*", "http://localhost:4000/api/v1/auth/callback"],
      "webOrigins": ["http://localhost:5173", "http://localhost:4173", "http://localhost:4000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "edas-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "edas-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "edas-cli",
      "name": "EDAS CLI and tests",
      "description": "Password grant client for local scripts and the end-to-end suite. Never used by the browser.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "edas-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "edas-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@edas.local",
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["system_admin", "employee"]
    },
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@edas.local",
      "emailVerified": true,
      "firstName": "Department",
      "lastName": "Manager",
      "credentials": [{ "type": "password", "value": "manager", "temporary": false }],
      "realmRoles": ["dept_manager", "employee"]
    },
    {
      "username": "employee",
      "enabled": true,
      "email": "employee@edas.local",
      "emailVerified": true,
      "firstName": "Regular",
      "lastName": "Employee",
      "credentials": [{ "type": "password", "value": "employee", "temporary": false }],
      "realmRoles": ["employee"]
    }
  ]
}
