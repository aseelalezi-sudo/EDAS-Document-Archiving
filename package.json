{
  "name": "edas-document-archiving",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "npm run stack:up && npm run dev",
    "build": "tsc --noEmit && vite build",
    "build:singlefile": "tsc --noEmit && vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"packages/**/*.ts\"",
    "api:install": "npm --prefix api install",
    "shared:build": "tsc -p packages/shared/tsconfig.json",
    "api:generate": "npm --prefix api run prisma:generate",
    "api:dev": "npm run shared:build && npm --prefix api run start:dev",
    "e2e": "pwsh -NoProfile -File scripts/e2e.ps1",
    "api:typecheck": "npm run shared:build && npm --prefix api run typecheck",
    "api:lint": "npm --prefix api run lint",
    "api:test": "npm run shared:build && npm --prefix api test",
    "api:build": "npm run shared:build && npm --prefix api run build",
    "demo:seed": "node scripts/seed-demo-documents.mjs",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dxf-viewer": "^1.0.50",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.5"
  }
}
