{
  "name": "@edas/api",
  "version": "0.1.0",
  "private": true,
  "description": "EDAS document archiving API (NestJS + Prisma)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mts",
    "maintenance:reconcile-departments": "node dist/maintenance/main.js"
  },
  "prisma": {
    "seed": "node prisma/seed.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@edas/shared": "file:../packages/shared",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@prisma/client": "^6.0.0",
    "bidi-shaper": "^0.1.2",
    "bullmq": "^6.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jwks-rsa": "^3.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "glob": "^14.0.4",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
