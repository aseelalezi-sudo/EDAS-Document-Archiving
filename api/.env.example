NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
# Production checklist: with NODE_ENV=production the API refuses to boot while any development
# default survives (KEYCLOAK_ADMIN_PASSWORD=admin, MINIO_SECRET_KEY=edas_minio_dev_pw, an
# edas_dev_pw database password), while SESSION_SECRET or DOWNLOAD_TICKET_SECRET is shorter than
# 32 characters, or while CORS_ORIGINS contains a non-HTTP(S) or http:// origin.
# See api/src/common/config/env.validation.ts.
# Public origin of the API, used to build absolute download links and the OIDC
# redirect URI. When unset the request Host (and X-Forwarded-Proto) is used, which
# is correct for local dev and for a reverse proxy that forwards both headers.
# API_PUBLIC_URL=https://edas.example.com

# Request hardening
# Largest JSON / form body the API accepts per request (default "2mb"). Uploads go
# straight to object storage through presigned URLs, so bodies stay small.
# BODY_LIMIT=2mb
# Global rate limit applied to every route, per client IP (default 600 requests
# per 60000 ms). Sign-in endpoints use a stricter built-in limit.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=600
# Structured JSON logging threshold: error | warn | log | debug | verbose
# (default "log"). Nest bootstrap lines are buffered and flushed through the same
# logger. Health probes are logged at debug so they stay out of the default stream.
# LOG_LEVEL=log

# Browser sessions (BFF)
# The SPA never holds tokens: the API runs the OIDC authorization-code flow and
# keeps the access/refresh/id tokens server-side behind an httpOnly session cookie
# (KEYCLOAK_CLIENT_SECRET and the redirect URI <API>/api/v1/auth/callback must be
# registered in Keycloak). APP_BASE_URL is the SPA origin the API redirects back to
# after login and logout.
APP_BASE_URL=http://localhost:5173
# SESSION_SECRET seals the stored tokens (32+ characters). Set the same value on
# every API instance; production refuses to start without it.
# SESSION_SECRET=replace-with-a-random-32-character-value
# Session lifetime in seconds (default 28800 = 8h); the provider refresh window
# still caps it. Optional cookie overrides:
# SESSION_TTL_SECONDS=28800
# SESSION_COOKIE_SECURE=true   # force Secure cookies behind a TLS-terminating proxy
# SESSION_COOKIE_SAMESITE=lax
# KEYCLOAK_CLIENT_SECRET=       # only for a confidential Keycloak client
# Secret used to seal 120-second download links (32+ characters). Set the same
# value on every API instance; when empty, links are ephemeral and only valid
# in the process that issued them.
# DOWNLOAD_TICKET_SECRET=replace-with-a-random-32-character-value

# PostgreSQL
DATABASE_URL=postgresql://edas:edas_dev_pw@localhost:5432/edas?schema=public

# Keycloak / OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/edas
# Optional: override the JWKS URL when the issuer is not directly reachable from the API
# KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/edas/protocol/openid-connect/certs
# Optional: base URL the API uses to call the token endpoint server-side. Set this when the
# public issuer host is not reachable from inside the API network (e.g. docker-compose).
# KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/edas
KEYCLOAK_AUDIENCE=edas-api
KEYCLOAK_CLIENT_ID=edas-web
# Keycloak Admin API (master realm) used to provision user accounts
# Optional: base URL for the Admin API when the issuer host is not reachable from the API
# KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=edas-documents
MINIO_ACCESS_KEY=edas_minio
MINIO_SECRET_KEY=edas_minio_dev_pw
# Optional: host used only when signing URLs for browsers (containers cannot use
# "minio"; the browser needs the published host). Defaults to MINIO_ENDPOINT.
# MINIO_PUBLIC_ENDPOINT=localhost
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=false
# MINIO_REGION=us-east-1
# MINIO_PRESIGN_EXPIRES=900

# Upload policy
# MAX_UPLOAD_BYTES caps a single presigned upload (default 52428800 = 50 MiB).
# MAX_UPLOAD_BYTES=52428800
# ALLOWED_UPLOAD_MIME overrides the built-in content-type allow-list (comma separated).
# The extension of the file name must match the declared type; markup and script
# types such as text/html and image/svg+xml are never accepted.
# ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,text/csv

# File preview
# Office documents are converted to PDF with LibreOffice headless and DWG files
# to DXF with the ODA File Converter. Both tools are detected at runtime; when
# they are missing the UI shows a clear "converter unavailable" state instead
# of failing the preview request.
# PREVIEW_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# PREVIEW_ODA_PATH=/usr/bin/ODAFileConverter
# PREVIEW_MAX_SOURCE_BYTES=52428800
# PREVIEW_MAX_OUTPUT_BYTES=209715200
# PREVIEW_TIMEOUT_MS=120000
# PREVIEW_CONCURRENCY=2
# PREVIEW_CACHE_SCAN_LIMIT=5000
# PREVIEW_PREWARM converts Office/CAD files in the background as soon as they are
# attached to a document, so the first preview opens instantly. Set to "off" to
# convert only when a preview is requested.
# PREVIEW_PREWARM=on
