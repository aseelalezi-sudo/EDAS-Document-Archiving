# SPA → API connection.
# Leave all three values unset to run the UI in offline prototype mode (mock auth + localStorage).
VITE_API_URL=http://localhost:4000
VITE_OIDC_ISSUER=http://localhost:8080/realms/edas
VITE_OIDC_CLIENT_ID=edas-web
VITE_OIDC_SCOPES="openid profile email"

# Browser sessions (BFF) - read by the API container. The SPA never holds tokens;
# the API keeps them server-side behind an httpOnly session cookie. SESSION_SECRET
# (32+ characters) must be identical across API replicas; APP_BASE_URL is the SPA
# origin the API redirects back to after login and logout.
# APP_BASE_URL=http://localhost:5173
# SESSION_SECRET=replace-with-a-random-32-character-value
