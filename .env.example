# SPA → API connection.
# Leave all three values unset to run the UI in offline prototype mode (mock auth + localStorage).
VITE_API_URL=http://localhost:4000
VITE_OIDC_ISSUER=http://localhost:8080/realms/edas
VITE_OIDC_CLIENT_ID=edas-web
VITE_OIDC_SCOPES="openid profile email"
# Recommended for any deployed build: fail instead of silently shipping the offline
# demo when one of the three connection variables above is missing.
# VITE_REQUIRE_API=true

# Browser sessions (BFF) - read by the API container. The SPA never holds tokens;
# the API keeps them server-side behind an httpOnly session cookie. SESSION_SECRET
# (32+ characters) must be identical across API replicas; APP_BASE_URL is the SPA
# origin the API redirects back to after login and logout.
# APP_BASE_URL=http://localhost:5173
# SESSION_SECRET=replace-with-a-random-32-character-value

# Observability (docker compose --profile observability).
# Prometheus reads METRICS_TOKEN through the metrics_token Docker secret.
# Set the OTLP endpoint to enable the API OpenTelemetry SDK.
# METRICS_TOKEN=replace-with-a-random-32-character-value
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=edas-api
# GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
